# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/acadease
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/acadease
MONGO_URI=mongodb://127.0.0.1:27017/acadease

# ---- Auth ----
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_STUDENT=24h
JWT_ACCESS_EXPIRES_STAFF=8h
JWT_ACCESS_EXPIRES_SUPERADMIN=4h
JWT_REFRESH_EXPIRES=7d

# ---- 2FA (TOTP) ----
TOTP_ISSUER=AcadEase

# ---- Certificate signing (anti-spoofing, Section 9 of PRD) ----
CERT_HMAC_SECRET=change_this_to_a_long_random_string_for_certificates
CERT_DOWNLOAD_URL_EXPIRES_HOURS=24

# ---- Institution defaults (used by seed script) ----
INSTITUTION_ID=TNTEU_001
INSTITUTION_NAME=Tamil Nadu Teachers Education University

# ---- Email (Nodemailer / Gmail SMTP) — optional for MVP, used for cert-ready + password reset ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- SMS (Twilio) — optional, used for result notifications to parents ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- API public URL (used in PDF download links sent via email/SMS) ----
API_URL=http://localhost:5000

# ---- Web Push (VAPID) — optional, in-app notifications work without this ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Wraps the RSA private keys that unseal admission documents.
# Losing this makes every stored admission proof permanently unreadable.
DOC_KEY_PASSPHRASE=change_this_to_a_long_random_string_for_document_keys

# ---- Deployment (Render / Vercel) ----
# CLIENT_URL accepts a comma-separated list of allowed front-end origins.
#   CLIENT_URL=https://acadease.vercel.app,http://localhost:5173
# Set to "true" to also allow Vercel's per-branch preview URLs (*.vercel.app).
ALLOW_VERCEL_PREVIEWS=false

# The SPA and API sit on different domains in production, which makes the
# refresh cookie third-party. Leave unset to follow NODE_ENV; set to "false"
# only if you serve the SPA from this same origin.
COOKIE_CROSS_SITE=

# ---- Institutional signing keys (pin these before deploying) ----
# On a host with an ephemeral filesystem (Render free tier) the keyring under
# secure-storage/keys is wiped on every deploy and silently regenerated — after
# which every certificate already issued reports itself as forged. Pin the keys
# here instead. Generate the values with:
#
#   node scripts/export-keys.mjs --render
#
# KEY_TNTEU_PRIVATE=<base64 PEM>
# KEY_TNTEU_PUBLIC=<base64 PEM>
# KEY_TNTEU_COL_0417_PRIVATE=<base64 PEM>
# KEY_TNTEU_COL_0417_PUBLIC=<base64 PEM>
