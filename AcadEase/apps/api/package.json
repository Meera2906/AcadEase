{
  "name": "acadease-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AcadEase backend \u00e2\u20ac\u201d Express + MongoDB API for the SheBuilds TNTEU problem statement",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:admissions": "node src/seed/seedAdmissions.js",
    "seed:governance": "node src/seed/seedGovernance.js",
    "reset:admissions": "node src/seed/resetAdmissions.js",
    "test": "node --test test/*.test.js",
    "e2e:admissions": "node e2e-admissions.mjs",
    "e2e:preadmission": "node e2e-preadmission.mjs",
    "e2e:signedflow": "node e2e-signedflow.mjs",
    "e2e:twostage": "node e2e-twostage.mjs",
    "e2e:reissue": "node e2e-grievance-reissue.mjs",
    "e2e": "node e2e-admissions.mjs && node e2e-preadmission.mjs && node e2e-signedflow.mjs && node e2e-twostage.mjs && node e2e-grievance-reissue.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "otplib": "^12.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.3",
    "twilio": "^6.0.2",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
